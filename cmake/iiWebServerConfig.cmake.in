@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(iiNetwork 0.5 CONFIG HINTS "$ENV{HOME}/.local/SDK/iiNetwork")
if(NOT iiNetwork_HTTP_SERVER_LIFECYCLE)
    set(iiWebServer_FOUND FALSE)
    set(iiWebServer_NOT_FOUND_MESSAGE "iiWebServer requires the iiNetwork package with HTTP lifecycle support")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiWebServerHttpTargets.cmake")
set(iiWebServer_Http_FOUND TRUE)
set(iiWebServer_COMPATIBILITY_AVAILABLE @IIWEBSERVER_BUILD_COMPATIBILITY@)
set(iiWebServer_Compatibility_FOUND ${iiWebServer_COMPATIBILITY_AVAILABLE})
set(iiWebServer_CURL_ENABLED @IIWEBSERVER_WITH_CURL@)
set(iiWebServer_STORAGE_PROCESS_ENABLED @IIWEBSERVER_WITH_STORAGE_PROCESS@)
set(_iiwebserver_load_compat FALSE)
if(NOT iiWebServer_FIND_COMPONENTS AND iiWebServer_COMPATIBILITY_AVAILABLE)
    set(_iiwebserver_load_compat TRUE)
endif()
foreach(_component IN LISTS iiWebServer_FIND_COMPONENTS)
    if(_component STREQUAL "Compatibility" AND iiWebServer_COMPATIBILITY_AVAILABLE)
        set(_iiwebserver_load_compat TRUE)
    elseif(NOT _component STREQUAL "Http" AND NOT _component STREQUAL "Compatibility")
        set(iiWebServer_${_component}_FOUND FALSE)
    endif()
endforeach()
if(_iiwebserver_load_compat)
    find_dependency(iiFileProvider 0.7 CONFIG HINTS "$ENV{IIFILEPROVIDER_PREFIX}" "$ENV{HOME}/.local/SDK/iiFileProvider")
    find_dependency(iiFileProviderNative 0.7 CONFIG HINTS "$ENV{IIFILEPROVIDER_PREFIX}" "$ENV{HOME}/.local/SDK/iiFileProvider")
    find_dependency(Qt6 6.8.3 EXACT COMPONENTS Core)
    if(@IIWEBSERVER_NEEDS_CRYPTO@)
        find_dependency(OpenSSL 3 COMPONENTS Crypto)
    endif()
    if(iiWebServer_CURL_ENABLED AND NOT @BUILD_SHARED_LIBS@)
        find_dependency(CURL 7.85)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/iiWebServerTargets.cmake")
endif()
unset(_iiwebserver_load_compat)
check_required_components(iiWebServer)
