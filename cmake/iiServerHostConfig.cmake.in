@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.8.3 EXACT COMPONENTS Core Network WebSockets)
if(@IISERVERHOST_NEEDS_CRYPTO@)
    find_dependency(OpenSSL 3 COMPONENTS Crypto)
endif()
set(iiServerHost_CURL_ENABLED @IISERVERHOST_WITH_CURL@)
set(iiServerHost_STORAGE_PROCESS_ENABLED @IISERVERHOST_WITH_STORAGE_PROCESS@)
if(@IISERVERHOST_WITH_CURL@ AND NOT @BUILD_SHARED_LIBS@)
    find_dependency(CURL 7.85)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiServerHostTargets.cmake")
check_required_components(iiServerHost)
